#include <stdio.h>

void sort_descending(int a[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int max_index = i;
        for (int j = i + 1; j < n; j++) {
            if (a[j] > a[max_index]) max_index = j;
        }
        int t = a[i];
        a[i] = a[max_index];
        a[max_index] = t;
    }
}

int is_descending(const int a[], int n) {
    for (int i = 0; i < n - 1; i++) {
        if (a[i] < a[i + 1]) return 0;
    }
    return 1;
}

int main(void) {
    int a1[] = {4, -2, 7, 4, 0};
    int n1 = 5;
    sort_descending(a1, n1);
    for (int i = 0; i < n1; i++) printf("%d ", a1[i]);
    printf("; проверка %d\n", is_descending(a1, n1));

    int a2[] = {5};
    int n2 = 1;
    sort_descending(a2, n2);
    for (int i = 0; i < n2; i++) printf("%d ", a2[i]);
    printf("; проверка %d\n", is_descending(a2, n2));

    int a3[] = {3, 1, 2};
    int n3 = 3;
    printf("Проверка без сортировки 3 1 2: %d\n", is_descending(a3, n3));

    int a4[] = {2, 2, 2};
    int n4 = 3;
    sort_descending(a4, n4);
    for (int i = 0; i < n4; i++) printf("%d ", a4[i]);
    printf("; свой тест (равные элементы), проверка %d\n", is_descending(a4, n4));

    return 0;
}
